[Unit]
Description=AosEdge Unit VM: %i
Documentation=man:aos-unit(8)

# The VM cannot outlive the manager: BindsTo propagates the manager's stop and
# failure here. There is deliberately no After=aos-unit.service: runner starts
# every instance itself once the network and the env file are ready, and that
# ordering edge would let systemd start instances before runner has run.
BindsTo=aos-unit.service

# Start jobs systemd queues on its own (a manager restart propagated through
# BindsTo, Restart= during teardown) are skipped, not failed, unless runner
# has written this node's env file and opened the node-start gate.
ConditionPathExists=/run/aos-unit/nodes/%i.env
ConditionPathExists=/run/aos-unit/allow-node-start

OnFailure=aos-unit-vm-failed@%n.service

# Give up after 3 failed starts in 5 minutes instead of restarting forever
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Slice=aos-unit.slice

User=aos-unit
Group=aos-unit

# Per-node values (image, MAC, tap, IP, vCPU, RAM, ...) are generated by runner
# before the instance is started. A missing file must not be a load error:
# ConditionPathExists above already skips the start in that case.
EnvironmentFile=-/run/aos-unit/network.conf
EnvironmentFile=-/run/aos-unit/nodes/%i.env

Environment="RUNTIME_DIRECTORY=/run/aos-unit"
Environment="LOGS_DIRECTORY=/var/log/aos-unit"
Environment="STATE_DIRECTORY=/var/lib/aos-unit"
Environment="NETWORK_CONFIG=network.conf"
Environment="DHCP_HOSTS_DIR=dnsmasq.d/dhcp-hosts"
Environment="DNS_HOSTS_DIR=dnsmasq.d/dns-hosts"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Conditions are evaluated when the start job is dequeued; this re-checks the
# gate right before anything is executed, closing the window in between.
ExecCondition=/usr/bin/test -e /run/aos-unit/allow-node-start

# $NODE_IP expands to zero arguments when the node has no static reservation
ExecStartPre=/usr/libexec/aos-unit/network-helper add-vm $NODE_MAC %i $NODE_TAP $NODE_IP
ExecStart=/usr/libexec/aos-unit/vm-launch %i
ExecStop=/usr/libexec/aos-unit/vm-shutdown %i
ExecStopPost=/usr/libexec/aos-unit/network-helper del-vm $NODE_MAC %i $NODE_TAP $NODE_IP

# The node-start gate already keeps Restart= from spawning a guest during
# teardown, so this only decides recovery. on-failure (not on-abort) also
# retries exit-code, OOM-kill and ExecStartPre failures, which can be
# transient on a real host; permanent ones stop at StartLimitBurst.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s

# Allow time for the guest to react to the ACPI power-down sent by vm-shutdown
TimeoutStopSec=60s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
OOMPolicy=kill

# NOTE: MemoryMax / CPUQuota are deliberately absent. They are per-node values
# from unit_config.yaml and systemd does not expand environment variables in
# resource directives, so runner applies them with
# `systemctl set-property --runtime` before starting the instance.

# --- Security hardening ---

# Needed by network-helper add-vm/del-vm to manage the tap interface
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

# ProtectSystem=strict makes everything read-only; the guest needs its image,
# the QMP/serial sockets and the log files
ReadWritePaths=/run/aos-unit
ReadWritePaths=/var/log/aos-unit
ReadWritePaths=/var/lib/aos-unit

DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/vhost-net rw
DeviceAllow=/dev/net/tun rw
