// PolicyKit rule for AosEdge Unit
// - Allows aos-unit to manage its systemd units: start/stop/restart the
//   aos-unit-node@ instances and the aos-unit-dnsmasq sidecar, set the nodes'
//   runtime resource limits (systemctl set-property --runtime), and stop the
//   transient units older releases left running across an upgrade
// - Allows aos-unit to configure systemd-resolved link DNS/domain (resolvectl)

polkit.addRule(function(action, subject) {
    if (subject.user !== "aos-unit") {
        return polkit.Result.NOT_HANDLED;
    }

    // systemctl start/stop/restart/reset-failed/set-property on aos-unit units
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.YES;
    }

    // Needed for: resolvectl dns <ifname> ... ; resolvectl domain <ifname> ...
    // Action IDs vary slightly by distro/systemd version, so allow all resolve1.*.
    if (action.id.indexOf("org.freedesktop.resolve1.") === 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});

