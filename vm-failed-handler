set -Eeuo pipefail

LIBEXEC_DIR="$(dirname "$(realpath "$0")")"
readonly LIBEXEC_DIR
readonly LOG_TAG="aos-unit:vm-failed"
. "${LIBEXEC_DIR}/log-helper"

: "${LOGS_DIRECTORY:?Environment variable LOGS_DIRECTORY is undefined}"

log_vm_failure() {
    local unit="$1"
    local context=""

    # A closed node-start gate means the manager is stopping, e.g. a guest that
    # ignored the ACPI power-down and was killed on TimeoutStopSec. Still worth
    # recording, but it must not read like a crash of a running VM.
    if [[ ! -e $NODE_START_GATE ]]; then
        context=" (during manager stop)"
    fi

    log "VM unit FAILED${context}: ${unit}"
    log "Writing failure marker to: ${LOGS_DIRECTORY}/vm-failures.log"

    log "systemctl status:"
    systemctl --no-pager -l status "${unit}" 2>&1 | error_multi || true

    log "Last 200 journal lines:"
    journalctl --no-pager -u "${unit}" -n 200 2>&1 | error_multi || true

    local ts
    ts="$(date -Is 2>/dev/null || date)"
    echo "${ts} ${unit} failed${context}" >>"${LOGS_DIRECTORY}/vm-failures.log"
}

main() {
    local -r unit="${1:?unit required}"
    log_vm_failure "$unit"
}

main "$@"
